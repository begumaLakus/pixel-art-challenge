            Katılım Olmadı
          </Text>

          <Text
            style={[
              styles.noWinnerMessage,
              { color: theme.placeholder },
            ]}
          >
            Bu meydan okumaya hiç çizim gönderilmedi.
          </Text>
        </View>
      )}
